{
  "name": "@heysalad-os/api",
  "version": "0.0.1",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev src/index.ts --local",
    "build": "wrangler deploy src/index.ts --dry-run",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "seed:enterprise:sql": "node scripts/generate-enterprise-seed.mjs 1000",
    "seed:enterprise:300": "node scripts/generate-enterprise-seed.mjs 300",
    "seed:enterprise:5000": "node scripts/generate-enterprise-seed.mjs 5000",
    "d1:migrate:local": "wrangler d1 migrations apply DB --local",
    "d1:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "d1:seed:local": "wrangler d1 execute DB --local --file scripts/generated-enterprise-seed.sql",
    "d1:seed:remote": "wrangler d1 execute DB --remote --file scripts/generated-enterprise-seed.sql"
  },
  "dependencies": {
    "@heysalad-os/domain": "0.0.1",
    "hono": "^4.6.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250303.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "wrangler": "^4.6.0"
  }
}
